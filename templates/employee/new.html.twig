{% extends 'base.html.twig' %}

{% block title %}Новый сотрудник{% endblock %}

{% block body %}
    <h1 class="mb-4">Добавить сотрудника</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.fullName) }}
                {{ form_row(form.hireDate) }}
                {{ form_row(form.baseVacationDays) }}
                {{ form_row(form.additionalVacationDays) }}
                {{ form_row(form.maxSeniorityAdditionalDays) }}

                <h4>Фиксированные дополнительные дни</h4>

                {# Скрытые прототипы полей #}
                <div class="d-none">
                    <div id="prototype-entitlement-startDate"
                         data-prototype="{{ form_widget(form.vacationEntitlements.vars.prototype.startDate)|e('html_attr') }}"></div>
                    <div id="prototype-entitlement-days"
                         data-prototype="{{ form_widget(form.vacationEntitlements.vars.prototype.days)|e('html_attr') }}"></div>
                </div>

                <div id="vacation-entitlements">
                    {% for entitlement in form.vacationEntitlements %}
                        <div class="entitlement-row mb-2 row align-items-end">
                            <div class="col">{{ form_widget(entitlement.startDate) }}</div>
                            <div class="col">{{ form_widget(entitlement.days) }}</div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-danger btn-sm remove-entitlement">Удалить</button>
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <button type="button" class="btn btn-secondary btn-sm add-entitlement">Добавить период</button>

                <h4>Периоды без начисления отпуска (декрет, отпуск по уходу за ребенком и т.п.)</h4>

                <div class="d-none">
                    <div id="prototype-nap-startDate" data-prototype="{{ form_widget(form.nonAccrualPeriods.vars.prototype.startDate)|e('html_attr') }}"></div>
                    <div id="prototype-nap-endDate" data-prototype="{{ form_widget(form.nonAccrualPeriods.vars.prototype.endDate)|e('html_attr') }}"></div>
                    <div id="prototype-nap-type" data-prototype="{{ form_widget(form.nonAccrualPeriods.vars.prototype.type)|e('html_attr') }}"></div>
                    <div id="prototype-nap-comment" data-prototype="{{ form_widget(form.nonAccrualPeriods.vars.prototype.comment)|e('html_attr') }}"></div>
                </div>

                <div id="non-accrual-periods">
                    {% for period in form.nonAccrualPeriods %}
                        <div class="nap-row mb-2 row align-items-end">
                            <div class="col">{{ form_widget(period.startDate) }}</div>
                            <div class="col">{{ form_widget(period.endDate) }}</div>
                            <div class="col">{{ form_widget(period.type) }}</div>
                            <div class="col">{{ form_widget(period.comment) }}</div>
                            <div class="col-auto"><button type="button" class="btn btn-danger btn-sm remove-nap">Удалить</button></div>
                        </div>
                    {% endfor %}
                </div>
                <button type="button" class="btn btn-secondary btn-sm add-nap">Добавить период</button>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a href="{{ path('app_employee_index') }}" class="btn btn-outline-secondary">Отмена</a>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('vacation-entitlements');
            const addButton = document.querySelector('.add-entitlement');
            let index = container.children.length;

            addButton.addEventListener('click', function() {
                // Получаем прототипы отдельных полей
                const startDatePrototype = document.getElementById('prototype-entitlement-startDate').dataset.prototype;
                const daysPrototype = document.getElementById('prototype-entitlement-days').dataset.prototype;

                // Заменяем __name__ на текущий индекс
                const startDateHtml = startDatePrototype.replace(/__name__/g, index);
                const daysHtml = daysPrototype.replace(/__name__/g, index);

                // Создаём строку с колонками
                const row = document.createElement('div');
                row.className = 'entitlement-row mb-2 row align-items-end';

                const col1 = document.createElement('div');
                col1.className = 'col';
                col1.innerHTML = startDateHtml;

                const col2 = document.createElement('div');
                col2.className = 'col';
                col2.innerHTML = daysHtml;

                const col3 = document.createElement('div');
                col3.className = 'col-auto';
                col3.innerHTML = '<button type="button" class="btn btn-danger btn-sm remove-entitlement">Удалить</button>';

                row.appendChild(col1);
                row.appendChild(col2);
                row.appendChild(col3);

                container.appendChild(row);
                index++;

                // Переинициализация flatpickr для новых datepicker
                flatpickr('.datepicker', { dateFormat: 'd.m.Y', allowInput: true, locale: 'ru' });
            });

            // Удаление строк
            container.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-entitlement')) {
                    e.target.closest('.entitlement-row').remove();
                }
            });
        });

        document.addEventListener('DOMContentLoaded', function() {
            const container = document.getElementById('non-accrual-periods');
            const addButton = document.querySelector('.add-nap');
            if (!container || !addButton) return;

            let index = container.children.length;

            addButton.addEventListener('click', function() {
                const p1 = document.getElementById('prototype-nap-startDate').dataset.prototype;
                const p2 = document.getElementById('prototype-nap-endDate').dataset.prototype;
                const p3 = document.getElementById('prototype-nap-type').dataset.prototype;
                const p4 = document.getElementById('prototype-nap-comment').dataset.prototype;

                const row = document.createElement('div');
                row.className = 'nap-row mb-2 row align-items-end';
                row.innerHTML = `
                    <div class="col">${p1.replace(/__name__/g, index)}</div>
                    <div class="col">${p2.replace(/__name__/g, index)}</div>
                    <div class="col">${p3.replace(/__name__/g, index)}</div>
                    <div class="col">${p4.replace(/__name__/g, index)}</div>
                    <div class="col-auto"><button type="button" class="btn btn-danger btn-sm remove-nap">Удалить</button></div>
                `;
                container.appendChild(row);
                index++;
                flatpickr('.datepicker', { dateFormat: 'd.m.Y', allowInput: true, locale: 'ru' });
            });

            container.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-nap')) {
                    e.target.closest('.nap-row').remove();
                }
            });
        });
    </script>
{% endblock %}