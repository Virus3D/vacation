{% extends 'base.html.twig' %}

{% block title %}Отпуска {{ employee.fullName }}{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="mb-0">{{ employee.fullName }}</h1>
            <p class="text-muted mb-0">Дата трудоустройства: {{ employee.hireDate|date('d.m.Y') }}</p>
        </div>
        <a href="{{ path('app_vacation_plan_new', {'employee': employee.id}) }}" class="btn btn-outline-primary">
            Запланировать отпуск
        </a>
    </div>

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body">
                    <h3>{{ remainingDays.main }}</h3>
                    <p class="text-muted">Основной отпуск</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body">
                    <h3>{{ remainingDays.additional }}</h3>
                    <p class="text-muted">Дополнительный отпуск</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card stat-card">
                <div class="card-body">
                    <h3>{{ remainingDays.total }}</h3>
                    <p class="text-muted">Всего доступно</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Детализация по рабочим годам</h5>
        </div>
        <div class="card-body">
            <table class="table">
                <thead>
                    <tr>
                        <th>Год работы</th>
                        <th>Период</th>
                        <th>Основной (остаток)</th>
                        <th>Дополнительный (остаток)</th>
                        <th>Всего (остаток)</th>
                    </tr>
                </thead>
                <tbody>
                    {% for detail in remainingDays.details %}
                        <tr>
                            <td>{{ detail.year_number }}</td>
                            <td>{{ detail.period }}</td>
                            <td
                                {% if detail.main_remaining > 0 %}class="text-success fw-bold"{% endif %}
                                {% if detail.main_remaining < 0 %}class="text-danger fw-bold"{% endif %}
                            >{{ detail.main_remaining }}</td>
                            <td
                                {% if detail.additional_remaining > 0 %}class="text-success fw-bold"{% endif %}
                                {% if detail.additional_remaining < 0 %}class="text-danger fw-bold"{% endif %}
                            >{{ detail.additional_remaining }}</td>
                            <td
                                {% if detail.total_remaining > 0 %}class="text-success fw-bold"{% endif %}
                                {% if detail.total_remaining < 0 %}class="text-danger fw-bold"{% endif %}
                            >{{ detail.total_remaining }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Новый отпуск</h5>
        </div>
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col-md-5">{{ form_row(form.startDate) }}</div>
                    <div class="col-md-5">{{ form_row(form.endDate) }}</div>
                    <div class="col-md-2">
                        {{ form_widget(form.calculate) }}
                    </div>
                </div>
                <div class="row">
                    <div class="form-check col-md-5 mb-3">
                        {{ form_widget(form.auto_calculate) }}
                        {{ form_label(form.auto_calculate) }}
                    </div>
                    <div class="form-check col-md-5 mb-3">
                        {{ form_widget(form.allowAdvance) }}
                        {{ form_label(form.allowAdvance) }}
                    </div>
                </div>
                <div id="manual-details" style="display: none;">
                    <h5>Ручное распределение дней</h5>
                    <div class="d-none">
                        <div id="prototype-workYear" data-prototype="{{ form_widget(form.details.vars.prototype.workYear)|e('html_attr') }}"></div>
                        <div id="prototype-vacationType" data-prototype="{{ form_widget(form.details.vars.prototype.vacationType)|e('html_attr') }}"></div>
                        <div id="prototype-daysUsed" data-prototype="{{ form_widget(form.details.vars.prototype.daysUsed)|e('html_attr') }}"></div>
                    </div>
                    <div id="vacation-details">
                        {% for detail in form.details %}
                            <div class="detail-row mb-2 row align-items-end">
                                <div class="col">{{ form_widget(detail.workYear) }}</div>
                                <div class="col">{{ form_widget(detail.vacationType) }}</div>
                                <div class="col">{{ form_widget(detail.daysUsed) }}</div>
                                <div class="col-auto"><button type="button" class="btn btn-danger btn-sm remove-detail">Удалить</button></div>
                            </div>
                        {% endfor %}
                    </div>
                    <button type="button" class="btn btn-secondary btn-sm add-detail">Добавить строку</button>
                </div>
                <div class="mt-3">
                    {{ form_widget(form.save) }}
                </div>
            {{ form_end(form) }}

            {% if calculationResult %}
                <div class="alert alert-info mt-3">
                    <h6>Результат расчета:</h6>
                    <p>Общее количество дней: {{ calculationResult.total_days }}</p>

                    {% if calculationResult.usage_details|length > 0 %}
                        <h6>Использование дней:</h6>
                        <ul>
                            {% for usage in calculationResult.usage_details %}
                                <li>
                                    Рабочий год {{ usage.work_year }}
                                    ({{ usage.period }}):
                                    {{ usage.days }} дней
                                    ({{ usage.type == 'main' ? 'основной' : 'дополнительный' }})
                                </li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    {% if calculationResult.insufficient_days > 0 %}
                        <div class="alert alert-danger">
                            Недостаточно дней! Не хватает: {{ calculationResult.insufficient_days }} дней
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">История отпусков</h5>
        </div>
        <div class="card-body">
            {% if vacations|length > 0 %}
                {% for vacation in vacations %}
                    <div class="vacation-details mb-3">
                        <strong>Период:</strong>
                        {{ vacation.startDate|date('d.m.Y') }} - {{ vacation.endDate|date('d.m.Y') }}
                        ({{ vacation.totalDays }} дней)
                        ({{ vacationDaysExcludingHolidays[vacation.id] }} дней без учёта праздников)

                        <div class="mt-2">
                            <strong>Использование:</strong>
                            <ul class="mb-0">
                                {% for detail in vacation.vacationDetails %}
                                    <li>
                                        Рабочий год: {{ detail.workYearStart|date('d.m.Y') }} - {{ detail.workYearEnd|date('d.m.Y') }}
                                        | {{ detail.daysUsed }} дней
                                        | {{ detail.vacationType == 'main' ? 'Основной' : 'Дополнительный' }}
                                    </li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endfor %}
            {% else %}
                <p class="text-muted">История отпусков отсутствует</p>
            {% endif %}
        </div>
    </div>

    <div class="mt-3">
        <a href="{{ path('app_employee_index') }}" class="btn btn-outline-secondary">Назад к списку</a>
    </div>
{% endblock %}
{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const autoCheckbox = document.querySelector('.auto-calculate-checkbox');
            const manualBlock = document.getElementById('manual-details');
            const detailsContainer = document.getElementById('vacation-details');
            const addButton = document.querySelector('.add-detail');

            function toggleManual() {
                if (autoCheckbox.checked) {
                    manualBlock.style.display = 'none';
                } else {
                    manualBlock.style.display = 'block';
                }
            }

            if (autoCheckbox) {
                autoCheckbox.addEventListener('change', toggleManual);
                toggleManual();
            }

            let index = detailsContainer.children.length;

            addButton.addEventListener('click', function() {
                // Получаем прототипы отдельных полей
                const workYearPrototype = document.getElementById('prototype-workYear').dataset.prototype;
                const vacationTypePrototype = document.getElementById('prototype-vacationType').dataset.prototype;
                const daysUsedPrototype = document.getElementById('prototype-daysUsed').dataset.prototype;

                // Заменяем __name__ на текущий индекс
                const workYearHtml = workYearPrototype.replace(/__name__/g, index);
                const vacationTypeHtml = vacationTypePrototype.replace(/__name__/g, index);
                const daysUsedHtml = daysUsedPrototype.replace(/__name__/g, index);

                // Создаём строку с колонками
                const row = document.createElement('div');
                row.className = 'detail-row mb-2 row align-items-end';

                const col1 = document.createElement('div');
                col1.className = 'col';
                col1.innerHTML = workYearHtml;

                const col2 = document.createElement('div');
                col2.className = 'col';
                col2.innerHTML = vacationTypeHtml;

                const col3 = document.createElement('div');
                col3.className = 'col';
                col3.innerHTML = daysUsedHtml;

                const col4 = document.createElement('div');
                col4.className = 'col-auto';
                col4.innerHTML = '<button type="button" class="btn btn-danger btn-sm remove-detail">Удалить</button>';

                row.appendChild(col1);
                row.appendChild(col2);
                row.appendChild(col3);
                row.appendChild(col4);

                detailsContainer.appendChild(row);
                index++;

                // Переинициализация datepicker, если необходимо
                flatpickr('.datepicker', { dateFormat: 'd.m.Y', allowInput: true, locale: 'ru' });
            });

            // Удаление строк
            detailsContainer.addEventListener('click', function(e) {
                if (e.target.classList.contains('remove-detail')) {
                    e.target.closest('.detail-row').remove();
                }
            });
        });
    </script>
{% endblock %}