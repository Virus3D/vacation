{% extends 'base.html.twig' %}

{% block title %}Сотрудники{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Сотрудники</h1>
        <form method="get" action="{{ path('app_employee_index') }}" class="d-flex align-items-center gap-2">
            <label for="date" class="form-label mb-0" style="white-space: nowrap;">Дата расчета:</label>
            <input type="date" id="date" name="date" class="form-control form-control-sm" value="{{ selectedDate }}" required>
            <button type="submit" class="btn btn-sm btn-primary">Обновить</button>
        </form>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Дата приема</th>
                <th>Дата увольнения</th>
                <th>Остаток дней</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {% for employee in employees %}
                {% set remaining = remainingDays[employee.id] ?? null %}
                <tr>
                    <td>{{ employee.fullName }}</td>
                    <td>{{ employee.hireDate|date('d.m.Y') }}</td>
                    <td>
                        {% if employee.terminationDate %}
                            {{ employee.terminationDate|date('d.m.Y') }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if remaining is not null %}
                            <span class="text-success fw-bold">{{ remaining.total }}</span>
                            <span class="text-muted small">(осн. {{ remaining.main }} / доп. {{ remaining.additional }})</span>
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_vacation_show', {'id': employee.id}) }}" class="btn btn-sm btn-primary">Управлять отпусками</a>
                        <a href="{{ path('app_employee_edit', {'id': employee.id}) }}" class="btn btn-sm btn-outline-secondary">Редактировать</a>
                        <form method="post" action="{{ path('app_employee_delete', {'id': employee.id}) }}" style="display: inline-block;" onsubmit="return confirm('Удалить сотрудника?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Сотрудники не найдены. <a href="{{ path('app_employee_new') }}">Добавить первого сотрудника</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}