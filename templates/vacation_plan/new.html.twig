{% extends 'base.html.twig' %}

{% block title %}Новый план отпуска{% endblock %}

{% block body %}
    <h1 class="mb-4">Планирование отпуска для {{ employee.fullName }}</h1>

    {% if error %}
        <div class="alert alert-danger">{{ error }}</div>
    {% endif %}

    {% if availableDays %}
        <div class="alert alert-info">
            Доступно на дату начала: {{ availableDays.total }} дней
            (основной: {{ availableDays.main }}, дополнительный: {{ availableDays.additional }})
        </div>
    {% endif %}

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                <div class="row">
                    <div class="col">{{ form_row(form.startDate) }}</div>
                    <div class="col">{{ form_row(form.endDate) }}</div>
                    <div class="col">{{ form_row(form.status) }}</div>
                    <div class="col">
                        <button type="submit" class="btn btn-primary">Сохранить</button>
                        <a href="{{ path('app_vacation_plan_index') }}" class="btn btn-outline-secondary">Отмена</a>
                    </div>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}