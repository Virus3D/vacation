{% extends 'base.html.twig' %}

{% block title %}График отпусков{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">График отпусков</h1>
        <form class="d-flex" method="get" action="{{ path('app_vacation_plan_new_select') }}">
            <select name="employee_id" class="form-select me-2" required>
                <option value="">-- Выберите сотрудника --</option>
                {% for emp in employees %}
                    <option value="{{ emp.id }}">{{ emp.fullName }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-primary">Создать план</button>
        </form>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Сотрудник</th>
                <th>Период</th>
                <th>Дней</th>
                <th>Статус</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {% for plan in plans %}
                <tr>
                    <td>{{ plan.employee.fullName }}</td>
                    <td>{{ plan.startDate|date('d.m.Y') }} - {{ plan.endDate|date('d.m.Y') }}</td>
                    <td>{{ plan.totalDays }}</td>
                    <td>
                        {% if plan.status == 'planned' %}
                            <span class="badge bg-warning">Запланирован</span>
                        {% elseif plan.status == 'approved' %}
                            <span class="badge bg-success">Утверждён</span>
                        {% else %}
                            <span class="badge bg-danger">Отклонён</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_vacation_plan_edit', {'id': plan.id}) }}" class="btn btn-sm btn-outline-primary">Изменить</a>
                        <form method="post" action="{{ path('app_vacation_plan_delete', {'id': plan.id}) }}" style="display: inline-block;">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ plan.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">Нет запланированных отпусков</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}