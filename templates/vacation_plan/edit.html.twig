{% extends 'base.html.twig' %}

{% block title %}Редактировать план отпуска{% endblock %}

{% block body %}
    <h1 class="mb-4">Редактирование плана для {{ plan.employee.fullName }}</h1>

    <div class="card">
        <div class="card-body">
            {{ form_start(form) }}
                {{ form_row(form.startDate) }}
                {{ form_row(form.endDate) }}
                {{ form_row(form.status) }}
                <button type="submit" class="btn btn-primary">Сохранить</button>
                <a href="{{ path('app_vacation_plan_index') }}" class="btn btn-outline-secondary">Отмена</a>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}