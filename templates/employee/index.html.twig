{% extends 'base.html.twig' %}

{% block title %}Сотрудники{% endblock %}

{% block body %}
    <h1 class="mb-4">Сотрудники</h1>

    <table class="table">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Дата приема</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            {% for employee in employees %}
                <tr>
                    <td>{{ employee.fullName }}</td>
                    <td>{{ employee.hireDate|date('d.m.Y') }}</td>
                    <td>
                        <a href="{{ path('app_vacation_show', {'id': employee.id}) }}" class="btn btn-sm btn-primary">Управлять отпусками</a>
                        <a href="{{ path('app_employee_edit', {'id': employee.id}) }}" class="btn btn-sm btn-outline-secondary">Редактировать</a>
                        <form method="post" action="{{ path('app_employee_delete', {'id': employee.id}) }}" style="display: inline-block;" onsubmit="return confirm('Удалить сотрудника?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ employee.id) }}">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Удалить</button>
                        </form>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="3">Сотрудники не найдены. <a href="{{ path('app_employee_new') }}">Добавить первого сотрудника</a></td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}